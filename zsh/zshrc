#  ==>  current editor buffer tricks
copy2x(){
  # aware of the os
  if [[ $(uname) == 'Darwin' ]]; then
      echo "$BUFFER" | pbcopy
  else
      echo "$BUFFER" | xclip -selection clipboard
  fi
}
zle -N copy2x
bindkey ",p" copy2x


output2x() {
    if [[ $(uname) == 'Darwin' ]]; then
      LBUFFER="${LBUFFER} | tee /dev/tty | pbcopy"
    else
      LBUFFER="${LBUFFER} | tee /dev/tty | xclip -selection clipboard"
    fi
  zle reset-prompt  
}
zle -N output2x
bindkey ",mm" output2x

pc4() {
  LBUFFER="proxychains4 ${LBUFFER}"
  zle reset-prompt  
}
zle -N pc4
bindkey ",px" pc4


fzf_git_files() {
    local file
    file=$(git ls-tree -r --name-only HEAD | fzf --height 50% --preview 'tree -C {}')
    
    if [[ -n "$file" ]]; then
        LBUFFER+="$file"
    fi
}

zle -N fzf_git_files
bindkey ',gg' fzf_git_files

