#  ==>  current editor buffer tricks
copy2x(){
  # aware of the os
  if [[ $(uname) == 'Darwin' ]]; then
      echo "$BUFFER" | pbcopy
  else
      echo "$BUFFER" | xclip -selection clipboard
  fi
}
zle -N copy2x
bindkey ",p" copy2x


output2x() {
    if [[ $(uname) == 'Darwin' ]]; then
      LBUFFER="${LBUFFER} | tee /dev/tty | pbcopy"
    else
      LBUFFER="${LBUFFER} | tee /dev/tty | xclip -selection clipboard"
    fi
  zle reset-prompt  
}
zle -N output2x
bindkey ",mm" output2x

pc4() {
  LBUFFER="proxychains4 ${LBUFFER}"
  zle reset-prompt  
}
