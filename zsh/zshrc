fzf_git_files() {
    local file
    file=$(git ls-tree -r --name-only HEAD | fzf --height 50% --preview 'tree -C {}')
    
    if [[ -n "$file" ]]; then
        LBUFFER+="$file"
    fi
}

zle -N fzf_git_files
bindkey ',gg' fzf_git_files

